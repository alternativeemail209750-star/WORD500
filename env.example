# Copy this file's contents into Render's "Environment" tab (do NOT upload
# a file called .env to GitHub — see the README for why).

# Your EulerStream signing key. Required for connecting to real TikTok
# LIVE streams. Get one free at https://www.eulerstream.com
# Test Mode works fine without this, so you can leave it blank at first.
EULERSTREAM_API_KEY=

# Render sets PORT automatically — you don't need to add this one yourself.
# PORT=3000
